new file mode 100644
index 00000000000..23ce62f270e
--- /dev/null
+++ b/arch/riscv/dts/cv1813h-milkv-duo-s.dts
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/* Copyright (C) 2026 Andreas Rehn <rehn.andreas86@gmail.com> */
+/dts-v1/;
+#include "cv1813h.dtsi"
+/ {
+	model = "Milk-V Duo S";
+	compatible = "milkv,duo-s", "sophgo,cv1813h";
+	aliases {
+		ethernet0 = &ethernet0;
+		serial0 = &uart0;
+		serial1 = &uart1;
+		serial2 = &uart2;
+		serial3 = &uart3;
+		serial4 = &uart4;
+		mmc0 = &sdhci0;
+		mmc1 = &emmc;
+	};
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x1fe00000>;
+	};
+};
+&ethernet0 { status = "okay"; phy-mode = "rmii"; };
+&osc { clock-frequency = <25000000>; };
+&sdhci0 { status = "okay"; bus-width = <4>; no-1-8-v; no-mmc; no-sdio; };
+&emmc { status = "okay"; bus-width = <4>; no-sd; no-sdio; non-removable; disable-wp; };
+&spif { status = "okay"; };
+&uart0 { status = "okay"; };
